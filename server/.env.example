MONGODB_URI=mongodb://127.0.0.1:27017/geo?replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
NODE_ENV=development
# Production (Render): path to Vite build copied into server/public
CLIENT_DIST=public
# Free Render has no Shell — auto-seed empty DBs, or POST /api/seed with x-seed-secret
SEED_ON_BOOT=false
SEED_SECRET=
SEED_ALLOW_WIPE=false
STRIPE_SECRET_KEY=
