# Copy to server/.env and adjust as needed.
# Never commit real secrets.

MONGODB_URI=mongodb://127.0.0.1:27017/geo?replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
NODE_ENV=development

# Optional — leave empty to use SimulatedPaymentGateway
STRIPE_SECRET_KEY=
